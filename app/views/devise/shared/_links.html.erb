<%# Only the links for modules that are actually enabled. There is deliberately
    no "Sign up": accounts are created by an administrator, never self-service. %>
<div class="mt-6 border-t border-slate-100 pt-4 text-sm">
  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Forgotten your password?", new_password_path(resource_name),
                class: "text-village underline underline-offset-2" %>
  <% end %>
</div>
