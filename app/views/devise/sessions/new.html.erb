<% content_for :title, "Village office sign in" %>

<div class="mx-auto mt-8 max-w-md">
  <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-8">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Nyika Village Registry</p>
    <h1 class="mt-1 text-2xl font-bold text-nyika-ink">Village office sign in</h1>
    <p class="mt-2 text-sm text-slate-600">
      For registry staff. Residents do not need an account — open the link the
      village office sent you.
    </p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                 html: { class: "mt-6 space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
                          class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, autocomplete: "current-password",
                             class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= f.check_box :remember_me, class: "h-4 w-4" %>
          Stay signed in on this device
        </label>
      <% end %>

      <%= f.submit "Sign in",
                   class: "w-full rounded-xl bg-nyika-ink px-4 py-3.5 text-base font-semibold text-white" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>

  <p class="mt-4 text-center text-sm">
    <%= link_to "Back to the public site", root_path,
                class: "text-slate-500 underline underline-offset-2 hover:text-nyika-ink" %>
  </p>
</div>
