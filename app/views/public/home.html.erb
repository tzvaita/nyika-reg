<% content_for :title, "Nyika Village" %>

<%= render "shared/ui/hero",
           eyebrow: "Goromonzi District · Zimbabwe",
           title: "One village. One digital front door.",
           lead: "Resident services, community mobilisation, heritage, diaspora support and village development in one connected platform." do %>
  <%= link_to "My Household", registry_path,
              class: "rounded-lg bg-gold px-5 py-3 text-center font-semibold text-village" %>
  <%= link_to "Pay / Contribute", payments_path,
              class: "rounded-lg bg-gold px-5 py-3 text-center font-semibold text-village" %>
  <%= link_to "About Nyika", about_path,
              class: "rounded-lg border border-white/35 px-5 py-3 text-center font-semibold text-white hover:bg-white/10" %>
<% end %>

<main class="mx-auto w-[min(1080px,calc(100%-28px))] py-10">
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <%= render "shared/ui/tile",
               tag: "LIVE",
               title: "Registry & Services",
               body: "Private household access using registered mobile number and Village PIN.",
               url: registry_path, label: "Open Registry" %>

    <%= render "shared/ui/tile",
               tag: "LIVE",
               title: "Have Your Say",
               body: "Share a comment, suggestion or village issue directly with the Nyika team.",
               url: have_your_say_path, label: "Open Form" %>

    <%= render "shared/ui/tile",
               tag: "LIVE",
               title: "Payments & Community Funds",
               body: "Traceable local collections with reconciliation before public disclosure.",
               url: payments_path, label: "Local Payments" %>

    <%= render "shared/ui/tile",
               tag: "LIVE",
               title: "Diaspora Contributions",
               body: "Mukuru, WorldRemit and international transfer routes linked to a Nyika reference.",
               url: diaspora_path, label: "Open Diaspora" %>

    <%= render "shared/ui/tile",
               title: "About Nyika Village",
               body: "Community, heritage, traditional life and a verified living village archive.",
               url: about_path, label: "Our Story" %>

    <%= render "shared/ui/tile",
               title: "Personal Privacy",
               body: "How household information is protected and separated from public statistics.",
               url: privacy_path, label: "Privacy & Consent" %>

    <%# The two village properties that live outside this application. %>
    <%= render "shared/ui/tile",
               title: "Our Daily Lives",
               body: "Community photos, short videos and everyday village stories.",
               url: "https://nyika-inauguration.vercel.app/daily-lives/",
               label: "Open Daily Lives", external: true %>

    <%= render "shared/ui/tile",
               title: "Build Nyika",
               body: "Community Centre mobilisation and project progress.",
               url: "https://nyika-build-mvp.vercel.app",
               label: "Open Build Nyika", external: true %>

    <%= render "shared/ui/tile",
               title: "Contact Us",
               body: "WhatsApp, SMS, call or assisted capture.",
               url: contact_path, label: "Contact Nyika" %>
  </div>

  <%= render "shared/ui/notice" do %>
    <b>Registry:</b> <%= registry_number %> ·
    <%= link_to "Administrator", new_user_session_path,
                class: "font-semibold text-village underline underline-offset-2" %>
  <% end %>
</main>
