<% content_for :title, "Nyika Village Registry" %>

<section class="bg-nyika-ink text-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
    <p class="text-sm font-medium uppercase tracking-widest text-white/70">Nyika Village</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-bold leading-tight sm:text-5xl">
      Register once. Access programmes. Mobilise transparently.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-white/85">
      One household record for the whole village — so a family tells its story
      once, support can be evidenced, and everyone can see where community
      contributions actually go.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <%= link_to "Ask to be registered", new_registration_request_path,
                  class: "rounded-xl bg-nyika-accent px-6 py-4 text-center text-base font-semibold text-white" %>
      <%= link_to "See where the money goes", campaigns_path,
                  class: "rounded-xl border border-white/30 px-6 py-4 text-center text-base font-semibold text-white hover:bg-white/10" %>
    </div>

    <p class="mt-6 text-sm text-white/70">
      Already registered? Open the link the village office sent you — there is no
      password to remember.
    </p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 py-16">
  <div class="grid gap-8 sm:grid-cols-2">
    <div>
      <h2 class="text-xl font-bold text-nyika-ink">What happens without it</h2>
      <ul class="mt-4 space-y-3 text-slate-700">
        <li class="flex gap-3">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nyika-accent"></span>
          The same family gives the same details again for every programme.
        </li>
        <li class="flex gap-3">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nyika-accent"></span>
          Collections are hard to reconcile, and receipts live in a book.
        </li>
        <li class="flex gap-3">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nyika-accent"></span>
          Who needs support is hard to evidence when someone asks.
        </li>
        <li class="flex gap-3">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nyika-accent"></span>
          Disputes come down to whose memory people trust.
        </li>
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-nyika-ink">What the register gives</h2>
      <p class="mt-4 text-slate-700">
        One trusted household record that programmes, contributions, receipts and
        outcomes attach to over time — with a history showing who submitted
        what, who checked it, and why anything changed.
      </p>
      <p class="mt-4 text-slate-700">
        Not another list. A record linked to what actually happens.
      </p>
    </div>
  </div>
</section>

<% if @open_campaigns.any? %>
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-xl font-bold text-nyika-ink">Open right now</h2>
          <p class="mt-1 text-slate-600">Live totals, not a report written afterwards.</p>
        </div>
        <%= link_to "See all", campaigns_path,
                    class: "text-sm font-semibold text-nyika-accent underline underline-offset-4" %>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @open_campaigns.each do |campaign| %>
          <%= render "public/campaign_card", campaign: campaign, compact: true %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section class="mx-auto max-w-5xl px-4 py-16">
  <div class="rounded-2xl bg-white p-8 shadow-sm">
    <h2 class="text-xl font-bold text-nyika-ink">Your details stay yours</h2>
    <p class="mt-3 max-w-2xl text-slate-700">
      We ask for as little as possible, you agree to each use separately, and
      every change is recorded with who made it and why. Nothing is quietly
      deleted, and personal information is never sold.
    </p>
    <p class="mt-5">
      <%= link_to "How we protect your details", trust_path,
                  class: "font-semibold text-nyika-accent underline underline-offset-4" %>
    </p>
  </div>
</section>
