<% content_for :title, "Where the money goes — Nyika Village Registry" %>

<section class="bg-village text-white">
  <div class="mx-auto max-w-5xl px-4 py-14">
    <h1 class="text-3xl font-bold sm:text-4xl">Where the money goes</h1>
    <p class="mt-4 max-w-2xl text-lg text-white/85">
      Every community collection, its target, and how much has actually been
      received and checked. Updated as payments are confirmed — not written up
      afterwards.
    </p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 py-14">
  <h2 class="text-xl font-bold text-village">Open now</h2>

  <% if @open_campaigns.any? %>
    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      <% @open_campaigns.each do |campaign| %>
        <%= render "public/campaign_card", campaign: campaign %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 rounded-2xl bg-white p-6 text-slate-600 shadow-sm">
      No collections are open at the moment.
    </p>
  <% end %>

  <% if @closed_campaigns.any? %>
    <h2 class="mt-14 text-xl font-bold text-village">Finished</h2>
    <div class="mt-6 overflow-x-auto rounded-2xl bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3">Collection</th>
            <th class="px-5 py-3">Target</th>
            <th class="px-5 py-3">Raised</th>
            <th class="px-5 py-3">Closed</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @closed_campaigns.each do |campaign| %>
            <tr>
              <td class="px-5 py-3 font-medium text-slate-900"><%= campaign.name %></td>
              <td class="px-5 py-3 text-slate-600">
                <%= campaign.target_amount ? "#{campaign.currency} #{number_with_delimiter(campaign.target_amount.to_i)}" : "—" %>
              </td>
              <td class="px-5 py-3 font-medium text-village">
                <%= campaign.currency %> <%= number_with_delimiter(campaign.received_amount.to_i) %>
              </td>
              <td class="px-5 py-3 text-slate-600"><%= campaign.closes_on&.strftime("%b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="mt-12 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="font-bold text-village">What you will not find here</h2>
    <p class="mt-2 max-w-2xl text-slate-700">
      We publish what a collection raised. We never publish who gave, how much
      they gave, or who has not given. What a household contributes is between
      them and the village office, and a public list would turn a collection into
      pressure.
    </p>
  </div>
</section>
