<% content_for :title, "Choose your Village PIN" %>

<%= render "shared/ui/hero",
           eyebrow: "First login security",
           title: "Choose your private Village PIN",
           lead: "Only you should know this. The village office cannot see it once you have set it." %>

<section class="mx-auto w-[min(1080px,calc(100%-28px))] py-10">
  <div class="mx-auto max-w-md">
    <%= render "shared/ui/card" do %>
      <% if local_assigns[:error].present? %>
        <p class="rounded-lg bg-caution px-4 py-3 text-sm text-[#8a3d2e]"><%= error %></p>
      <% end %>

      <% if resident_household.pin_temporary? %>
        <p class="text-sm text-muted">
          You signed in with the temporary PIN the office gave you. Choose your
          own before carrying on.
        </p>
      <% end %>

      <%= form_with url: change_pin_path, method: :patch, class: "mt-4 space-y-4" do %>
        <div>
          <%= label_tag :pin, "New PIN", class: "block text-sm font-semibold text-ink" %>
          <%= password_field_tag :pin, nil, inputmode: "numeric",
                                 autocomplete: "new-password", placeholder: "6 to 10 digits",
                                 class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <div>
          <%= label_tag :pin_confirmation, "Enter it again",
                        class: "block text-sm font-semibold text-ink" %>
          <%= password_field_tag :pin_confirmation, nil, inputmode: "numeric",
                                 autocomplete: "new-password",
                                 class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <%= submit_tag "Save my PIN",
                       class: "w-full rounded-xl bg-village px-4 py-3.5 text-base font-semibold text-white" %>
      <% end %>

      <p class="mt-4 text-xs text-muted">
        Do not use your year of birth or a number others could guess. If someone
        else learns it, ask the office for a new one.
      </p>
    <% end %>
  </div>
</section>
