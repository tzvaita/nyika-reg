<% content_for :title, "Make a payment" %>
<%= render "shared/resident_header", household: @household %>
<%= render "shared/resident_menu", token: @household.token %>

<% if @campaigns.none? %>
  <div class="mt-4 rounded-2xl bg-white p-5 text-sm text-slate-600 shadow-sm">
    There are no collections open at the moment.
  </div>
<% end %>

<% @campaigns.each do |campaign| %>
  <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <h2 class="font-semibold text-slate-900"><%= campaign.name %></h2>
      <span class="shrink-0 rounded-full px-3 py-1 text-xs font-medium
                   <%= campaign.approved_obligation? ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-900' %>">
        <%= campaign.approved_obligation? ? "Agreed obligation" : "Voluntary" %>
      </span>
    </div>
    <p class="mt-1 text-sm text-slate-600"><%= campaign.purpose %></p>

    <% if campaign.target_amount %>
      <p class="mt-3 text-sm text-slate-700">
        Target <strong><%= campaign.currency %> <%= campaign.target_amount.to_i %></strong> ·
        raised so far <strong><%= campaign.currency %> <%= campaign.received_amount.to_i %></strong>
        <% if campaign.suggested_contribution %>
          · suggested <strong><%= campaign.currency %> <%= campaign.suggested_contribution.to_i %></strong>
        <% end %>
      </p>
      <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-200">
        <div class="h-2 rounded-full bg-nyika-ink" style="width: <%= [campaign.progress_percentage.to_f, 100].min %>%"></div>
      </div>
    <% elsif campaign.target_description.present? %>
      <p class="mt-3 text-sm text-slate-700">Needed: <strong><%= campaign.target_description %></strong></p>
    <% end %>

    <%# The approved account, shown to the person who needs it. This is what
        stops a household paying the wrong account or an unauthorised collector. %>
    <div class="mt-4 rounded-lg bg-slate-100 p-3 text-sm">
      <p class="font-medium text-slate-900">Pay to</p>
      <p class="mt-1 text-slate-700"><%= campaign.receiving_account_name %></p>
      <p class="text-slate-700"><%= campaign.receiving_account_detail %></p>
      <p class="mt-2 text-xs text-slate-500">
        Only pay to this account or to a collector the village office has named.
        Keep the reference your payment gives you.
      </p>
    </div>

    <%= form_with url: resident_payments_path(token: @household.token), method: :post,
                  class: "mt-4 space-y-3" do %>
      <%= hidden_field_tag "mobilisation_campaign_id", campaign.id %>

      <div>
        <%= label_tag "contribution_kind_#{campaign.id}", "What are you giving?",
                      class: "block text-sm font-medium text-slate-700" %>
        <%= select_tag "contribution_kind",
                       options_for_select(Contribution.contribution_kinds.keys.map { |k| [k.humanize, k] }, "money"),
                       id: "contribution_kind_#{campaign.id}",
                       class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= label_tag "amount_#{campaign.id}", "Amount (#{campaign.currency})",
                        class: "block text-sm font-medium text-slate-700" %>
          <%= number_field_tag "amount", campaign.suggested_contribution&.to_i,
                               step: "0.01", id: "amount_#{campaign.id}",
                               class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        </div>
        <div>
          <%= label_tag "payment_method_#{campaign.id}", "How", class: "block text-sm font-medium text-slate-700" %>
          <%= select_tag "payment_method",
                         options_for_select(Contribution.payment_methods.keys.map { |m| [m.humanize, m] }),
                         include_blank: "Not sure yet",
                         id: "payment_method_#{campaign.id}",
                         class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        </div>
      </div>

      <div>
        <%= label_tag "item_description_#{campaign.id}", "If materials or labour, what exactly?",
                      class: "block text-sm font-medium text-slate-700" %>
        <%= text_field_tag "item_description", nil, id: "item_description_#{campaign.id}",
                           placeholder: "e.g. two days of labour",
                           class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
      </div>

      <%= submit_tag "Record what I will give",
                     class: "w-full rounded-xl bg-nyika-ink px-4 py-4 text-base font-semibold text-white" %>
    <% end %>
  </div>
<% end %>

<% if @contributions.any? %>
  <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm">
    <h2 class="font-semibold text-slate-900">What you have promised</h2>
    <ul class="mt-2 divide-y divide-slate-100">
      <% @contributions.each do |contribution| %>
        <li class="flex items-center justify-between gap-3 py-3 text-sm">
          <span>
            <span class="font-medium"><%= contribution.describes %></span><br>
            <span class="text-xs text-slate-500"><%= contribution.mobilisation_campaign.name %></span>
          </span>
          <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
            <%= contribution.status.humanize %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
<div class="pb-8"></div>
