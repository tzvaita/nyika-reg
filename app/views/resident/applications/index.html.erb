<% content_for :title, "My applications" %>
<%= render "shared/resident_header", household: @household %>
<%= render "shared/resident_menu", token: @household.token %>

<div class="mt-4 space-y-3">
  <% if @cases.none? %>
    <div class="rounded-2xl bg-white p-5 text-sm text-slate-600 shadow-sm">
      <p>You have not asked for any support yet.</p>
      <p class="mt-2">
        <%= link_to "Ask to be considered for support", resident_support_path(token: @household.token),
                    class: "font-medium text-village underline underline-offset-2" %>
      </p>
    </div>
  <% end %>

  <% @cases.each do |programme_case| %>
    <div class="rounded-2xl bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="font-semibold text-slate-900"><%= programme_case.programme_type.humanize %></p>
          <p class="text-xs text-slate-500">
            <%= programme_case.reference %> · opened <%= programme_case.opened_on.strftime("%d %b %Y") %>
          </p>
        </div>
        <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
          <%= programme_case.status.humanize %>
        </span>
      </div>

      <p class="mt-3 text-sm text-slate-700">
        <% case programme_case.status %>
        <% when "identified", "awaiting_consent" %>
          The village office has your request and will be in touch.
        <% when "gathering_evidence" %>
          The office is collecting what is needed to send your application.
        <% when "ready_to_submit" %>
          Everything is ready. The office will send your application.
        <% when "submitted" %>
          Your application has been sent to the programme office. They decide,
          and the village office will record what they say.
        <% when "closed" %>
          <%= programme_case.outcome&.humanize || "This request has been closed." %>
          <%= programme_case.outcome_note %>
        <% end %>
      </p>

      <% if programme_case.missing_document_types.any? && !programme_case.closed? %>
        <div class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">
          <p class="font-medium">Still needed:</p>
          <ul class="mt-1 list-disc pl-5">
            <% programme_case.missing_document_types.each do |type| %>
              <li><%= type.humanize %></li>
            <% end %>
          </ul>
          <p class="mt-2 text-xs">Bring these to the village office.</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
<div class="pb-8"></div>
