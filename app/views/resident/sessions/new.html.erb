<% content_for :title, "My Household — Nyika Village" %>

<%= render "shared/ui/hero",
           eyebrow: "Private household access",
           title: "My Household",
           lead: "Sign in with your phone number and the PIN the village office gave you." %>

<section class="mx-auto w-[min(1080px,calc(100%-28px))] py-10">
  <div class="mx-auto max-w-md">
    <%= render "shared/ui/card", title: "Access my household" do %>
      <%= form_with url: registry_path, method: :post, class: "mt-4 space-y-4" do %>
        <div>
          <%= label_tag :contact_number, "Phone number",
                        class: "block text-sm font-semibold text-ink" %>
          <%= text_field_tag :contact_number, @household_hint,
                             inputmode: "tel", autocomplete: "tel",
                             placeholder: "e.g. 0775103375",
                             class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <div>
          <%= label_tag :pin, "Your Village PIN", class: "block text-sm font-semibold text-ink" %>
          <%= password_field_tag :pin, nil, inputmode: "numeric",
                                 autocomplete: "current-password",
                                 placeholder: "6 to 10 digits",
                                 class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <%= submit_tag "Sign in",
                       class: "w-full rounded-xl bg-village px-4 py-3.5 text-base font-semibold text-white" %>
      <% end %>

      <div class="mt-6 border-t border-rule pt-4 text-sm text-muted">
        <p class="font-semibold text-ink">Do not have a PIN, or forgotten it?</p>
        <p class="mt-1">
          Speak to the village office. PINs are given out in person — nobody can
          set or reset one just by knowing your phone number, and that is what
          keeps your household details yours.
        </p>
        <p class="mt-3">
          Not registered yet?
          <%= link_to "Ask to be registered", new_registration_request_path,
                      class: "font-semibold text-village underline underline-offset-2" %>
        </p>
      </div>
    <% end %>
  </div>
</section>
