<% content_for :title, "Thank you — Nyika Village" %>

<section class="mx-auto w-[min(1080px,calc(100%-28px))] py-20">
  <div class="mx-auto max-w-lg text-center">
    <%= render "shared/ui/card" do %>
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-affirm">
        <span class="text-2xl text-village" aria-hidden="true">&check;</span>
      </div>
      <h1 class="mt-5 text-2xl text-village">Response received</h1>
      <p class="mt-3 text-muted">Thank you.</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted">
        Your comment has gone to the village office. If you left a way to reach
        you, someone will reply; otherwise it will be answered at a village
        meeting.
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <%= link_to "Back to the start", root_path,
                    class: "rounded-xl bg-village px-6 py-3 text-sm font-semibold text-white" %>
        <%= link_to "Say something else", have_your_say_path,
                    class: "rounded-xl border border-rule px-6 py-3 text-sm font-semibold text-ink" %>
      </div>
    <% end %>
  </div>
</section>
