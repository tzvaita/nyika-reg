<% content_for :title, "Have Your Say — Nyika Village" %>

<%= render "shared/ui/hero",
           eyebrow: "For Nyika · By Nyika",
           title: "Have Your Say.",
           lead: "Share a comment, suggestion or village issue directly with the Nyika team. Three fields. One minute." %>

<main class="mx-auto w-[min(1080px,calc(100%-28px))] py-10">
  <div class="mx-auto max-w-[620px]">
    <div class="rounded-2xl border border-rule bg-white p-5 sm:p-6">
      <h2 class="font-display text-xl text-village">Send your comment</h2>
      <p class="mt-2 text-sm text-muted">
        Your response goes into the Nyika participation register for review and
        follow-up.
      </p>

      <%= form_with model: @feedback, url: feedbacks_path, class: "mt-5 space-y-4" do |f| %>
        <% if @feedback.errors.any? %>
          <div class="rounded-lg bg-caution p-4 text-sm text-[#8a3d2e]">
            <ul class="list-disc pl-5">
              <% @feedback.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Name", class: "block text-sm font-semibold text-ink" %>
          <%= f.text_field :name, autocomplete: "name", maxlength: 120,
                           placeholder: "Your name",
                           class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <div>
          <%= f.label :contact_method, "Phone", class: "block text-sm font-semibold text-ink" %>
          <%= f.text_field :contact_method, type: "tel", inputmode: "tel",
                           autocomplete: "tel", maxlength: 40,
                           placeholder: "e.g. 0775103375",
                           class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <div>
          <%= f.label :category, "What is this about?", class: "block text-sm font-semibold text-ink" %>
          <%= f.select :category,
                       Feedback.categories.keys.map { |c| [ c.humanize, c ] }, {},
                       class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <div>
          <%= f.label :message, "Comment", class: "block text-sm font-semibold text-ink" %>
          <%= f.text_area :message, rows: 6, maxlength: 2000, required: true,
                          placeholder: "Your comment, suggestion or village issue...",
                          class: "mt-1 w-full rounded-lg border border-rule px-3 py-3 text-base" %>
        </div>

        <%# Honeypot, matching theirs: a field no person sees. %>
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
        </div>

        <%= f.submit "Submit to Nyika",
                     class: "w-full rounded-lg bg-village px-4 py-3.5 text-base font-semibold text-white" %>
      <% end %>

      <p class="mt-4 text-sm text-muted">
        Your name and phone number are used to understand the submission and
        contact you where follow-up is needed. They are not displayed publicly.
      </p>
      <%# This build allows both to be left blank — a comment that can only be
          made under a name is not really an open channel. %>
      <p class="mt-2 text-xs text-muted">
        Both may be left blank if you would rather not give them.
      </p>
    </div>
  </div>
</main>
