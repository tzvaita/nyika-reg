<% content_for :title, "Request sent — Nyika Village Registry" %>

<section class="mx-auto max-w-3xl px-4 py-20">
  <div class="rounded-2xl bg-white p-8 text-center shadow-sm">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100">
      <span class="text-2xl text-emerald-700" aria-hidden="true">&check;</span>
    </div>
    <h1 class="mt-5 text-2xl font-bold text-village">Thank you — your request has been sent</h1>
    <p class="mx-auto mt-3 max-w-md text-slate-700">
      Someone from the village office will be in touch. They will explain what the
      register is for and take your details with you, in person.
    </p>
    <p class="mx-auto mt-3 max-w-md text-sm text-slate-500">
      Nothing about your household has been recorded yet.
    </p>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <%= link_to "How we protect your details", trust_path,
                  class: "rounded-xl border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700" %>
      <%= link_to "Back to the start", root_path,
                  class: "rounded-xl bg-village px-6 py-3 text-sm font-semibold text-white" %>
    </div>
  </div>
</section>
