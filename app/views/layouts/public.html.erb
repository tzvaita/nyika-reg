<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nyika Village" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#173f31">
    <meta name="description" content="Nyika Village — resident services, community mobilisation, heritage, diaspora support and village development in one connected platform.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# No web fonts: Georgia and Arial ship with the device, and a download is a
        slow first render on the handsets this is actually read on. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <%= render "shared/public_nav" %>

    <main>
      <% if flash[:alert].present? %>
        <div class="mx-auto w-[min(1080px,calc(100%-28px))] pt-4">
          <p class="rounded-lg bg-caution px-4 py-3 text-sm text-[#8a3d2e]"><%= flash[:alert] %></p>
        </div>
      <% end %>
      <% if flash[:notice].present? %>
        <div class="mx-auto w-[min(1080px,calc(100%-28px))] pt-4">
          <p class="rounded-lg bg-affirm px-4 py-3 text-sm text-village"><%= flash[:notice] %></p>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mt-16 border-t border-rule bg-white">
      <div class="mx-auto w-[min(1080px,calc(100%-28px))] py-8 text-sm text-muted">
        <p>Nyika Village · Tradition · Service · Community · Transparent Development</p>
        <%# This is a claim the app actually keeps: public_site_test.rb asserts no
            household name, reference or contributor appears on any public page. %>
        <p class="mt-1">
          Personal information is protected. Public statistics are aggregated and
          do not expose individual household records.
        </p>
        <nav class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          <%= link_to "About", about_path, class: "hover:text-village" %>
          <%= link_to "Privacy", privacy_path, class: "hover:text-village" %>
          <%= link_to "Contact", contact_path, class: "hover:text-village" %>
          <%= link_to "Have your say", have_your_say_path, class: "hover:text-village" %>
          <%= link_to "Village office sign in", new_user_session_path, class: "hover:text-village" %>
        </nav>
      </div>
    </footer>
  </body>
</html>
