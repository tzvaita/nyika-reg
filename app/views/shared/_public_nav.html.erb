<%# The menu button is the only JavaScript here; the links below work without it. %>
<header class="border-b border-rule bg-white" data-controller="nav">
  <div class="mx-auto flex h-[66px] w-[min(1080px,calc(100%-28px))] items-center gap-3">
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-village font-display text-sm font-bold text-white">NY</span>
      <span class="font-display text-sm font-bold tracking-[0.12em] text-village">NYIKA VILLAGE</span>
    <% end %>

    <nav class="ml-auto hidden items-center gap-5 text-sm font-medium text-ink sm:flex">
      <%= link_to "My Household", registry_path, class: "hover:text-village" %>
      <%= link_to "Payments", payments_path, class: "hover:text-village" %>
      <%= link_to "Diaspora", diaspora_path, class: "hover:text-village" %>
      <%= link_to "Have your say", have_your_say_path, class: "hover:text-village" %>
      <%= link_to "Register", new_registration_request_path,
                  class: "rounded-lg bg-gold px-4 py-2 font-semibold text-village" %>
    </nav>

    <button type="button" data-action="nav#toggle" data-nav-target="button"
            aria-expanded="false" aria-controls="public-menu"
            class="ml-auto rounded-lg border border-rule px-3 py-2 text-sm font-medium sm:hidden">
      Menu
    </button>
  </div>

  <%# Visible by default so the site navigates with JavaScript off; the
      controller hides it on connect and toggles from there. %>
  <nav id="public-menu" data-nav-target="menu"
       class="border-t border-rule px-4 pb-4 pt-2 text-sm sm:hidden">
    <div class="mx-auto flex w-[min(1080px,calc(100%-28px))] flex-col gap-1">
      <%= link_to "My Household", registry_path, class: "rounded-lg px-3 py-3 hover:bg-parchment" %>
      <%= link_to "Payments", payments_path, class: "rounded-lg px-3 py-3 hover:bg-parchment" %>
      <%= link_to "Diaspora", diaspora_path, class: "rounded-lg px-3 py-3 hover:bg-parchment" %>
      <%= link_to "Have your say", have_your_say_path, class: "rounded-lg px-3 py-3 hover:bg-parchment" %>
      <%= link_to "About", about_path, class: "rounded-lg px-3 py-3 hover:bg-parchment" %>
      <%= link_to "Register my household", new_registration_request_path,
                  class: "rounded-lg bg-gold px-3 py-3 text-center font-semibold text-village" %>
      <%= link_to "Village office sign in", new_user_session_path,
                  class: "rounded-lg px-3 py-3 text-muted hover:bg-parchment" %>
    </div>
  </nav>
</header>
