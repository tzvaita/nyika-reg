<% content_for :title, "Capture a household" %>

<div class="rounded-2xl bg-white p-5 shadow-sm">
  <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Assisted capture</p>
  <h1 class="mt-1 text-xl font-bold text-village">Capture a household</h1>
  <p class="mt-1 text-sm text-slate-600">
    Signed in as <%= current_user.display_name %>. Your name is recorded against
    everything you capture.
  </p>
</div>

<%= render "capture/households/form",
           household: @household,
           url: capture_households_path(registration_request_id: params[:registration_request_id]),
           method: :post,
           submit_label: "Save household" %>
