# Copy to .env for local development. .env is gitignored — never commit real values.
# Loaded by dotenv-rails in development/test only.

# PostgreSQL. Blank host/user uses the local socket + your OS user.
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Seeded demo logins (db/seeds.rb). Development only.
SEED_ADMIN_EMAIL=admin@nyika.local
SEED_ADMIN_PASSWORD=
TWILIO_STATUS_CALLBACK_URL=    # e.g. https://your-app/webhooks/whatsapp/status
APP_BASE_URL=                  # used to derive the status callback URL if unset
